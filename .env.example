# ===================== Registry =====================
AGENTNET_DATABASE_URL=postgresql+asyncpg://agentnet:agentnet@localhost:5432/agentnet
AGENTNET_REGISTRY_HOST=0.0.0.0
AGENTNET_REGISTRY_PORT=9000
# 本地 embedding 模型(sentence-transformers,首次运行自动下载 ~2.3GB)
AGENTNET_EMBEDDING_MODEL=BAAI/bge-m3
# HuggingFace 镜像(国内网络可打开)
# HF_ENDPOINT=https://hf-mirror.com
# 管理 key:用于签发 provider/consumer API key
AGENTNET_ADMIN_KEY=changeme-admin-key

# ===================== Router / CLI =====================
AGENTNET_REGISTRY_URL=http://localhost:9000
AGENTNET_CONSUMER_KEY=
# 精排 + 本地兜底用的 LLM(OpenAI 兼容端点)
AGENTNET_LLM_BASE_URL=https://api.openai.com/v1
AGENTNET_LLM_API_KEY=
AGENTNET_LLM_MODEL=gpt-4o-mini
# 精排置信度低于该值则 fallback 本地
AGENTNET_ROUTE_THRESHOLD=0.65
# 召回候选数
AGENTNET_RECALL_TOP_K=10
