# ---- App ----
AGENTNET_APP_NAME=AgentNet
AGENTNET_HOST=0.0.0.0
AGENTNET_PORT=8000
AGENTNET_DEBUG=false

# ---- Database (PostgreSQL recommended for JSONB) ----
AGENTNET_DATABASE_URL=postgresql+asyncpg://agentnet:agentnet@localhost:5432/agentnet

# ---- LLM (OpenAI compatible endpoint, e.g. DeepSeek/Qwen/Tongyi) ----
AGENTNET_LLM_BASE_URL=https://api.deepseek.com/v1
AGENTNET_LLM_API_KEY=sk-replace-me
AGENTNET_LLM_MODEL=deepseek-chat

# ---- Token clipping ----
AGENTNET_STEP_OUTPUT_TOKEN_LIMIT=2048
AGENTNET_TIKTOKEN_ENCODING=cl100k_base

# ---- Governance ----
AGENTNET_AGENT_RPS_LIMIT=20
AGENTNET_BREAKER_WINDOW_SEC=10
AGENTNET_BREAKER_FAIL_THRESHOLD=5
AGENTNET_BREAKER_OPEN_SEC=60

# ---- Health check ----
AGENTNET_HEALTH_CORE_INTERVAL_SEC=30
AGENTNET_HEALTH_EDGE_INTERVAL_SEC=300
AGENTNET_HEALTH_PROBE_TIMEOUT_MS=2000
AGENTNET_HEALTH_FAIL_THRESHOLD=3
AGENTNET_HEALTH_CORE_IDLE_MINUTES=60
AGENTNET_HEALTH_EDGE_IDLE_MINUTES=1440
